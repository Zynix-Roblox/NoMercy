local function addSlider(page, text, stateKey, min, max, def)
    local f = Instance.new("Frame", page)
    f.Size = UDim2.new(0.95, 0, 0, 50)
    f.BackgroundColor3 = CONFIG.Background
    createVisuals(f, 5, 1, CONFIG.Outline)
    
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, 0, 0, 25)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Font = CONFIG.Font
    l.Text = text .. ": " .. def
    l.TextColor3 = CONFIG.Text
    l.TextSize = 13
    l.TextXAlignment = Enum.TextXAlignment.Left
    
    local bg = Instance.new("Frame", f)
    bg.Size = UDim2.new(0.9, 0, 0, 6)
    bg.Position = UDim2.new(0.5, 0, 0.75, 0)
    bg.AnchorPoint = Vector2new(0.5, 0.5)
    bg.BackgroundColor3 = CONFIG.Secondary
    createVisuals(bg, 3, 1, CONFIG.Outline)
    
    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = CONFIG.Accent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
    
    local function update(input)
        local p = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(p, 0, 1, 0)
        local val = math.floor(min + (max - min) * p)
        State[stateKey] = val
        l.Text = text .. ": " .. val
    end
    
    local dragging = false
    bg.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end end)
    State[stateKey] = def
end

