-- MASTER LOGIC ENGINE
local Camera = workspace.CurrentCamera
local FOVCircle = DrawingNew("Circle")
FOVCircle.Thickness = 1; FOVCircle.NumSides = 64; FOVCircle.Transparency = 1

local ESP_Data = {}
local function getESP(p)
    if not ESP_Data[p] then
        ESP_Data[p] = {
            Box = DrawingNew("Square"),
            Name = DrawingNew("Text"),
            Tracer = DrawingNew("Line"),
            Skeleton = {
                HeadTorso = DrawingNew("Line"),
                TorsoLArm = DrawingNew("Line"),
                TorsoRArm = DrawingNew("Line"),
                TorsoLLeg = DrawingNew("Line"),
                TorsoRLeg = DrawingNew("Line")
            }
        }
    end
    return ESP_Data[p]
end

local function cleanESP(p)
    local data = ESP_Data[p]
    if data then
        data.Box:Remove(); data.Name:Remove(); data.Tracer:Remove()
        for _, line in pairs(data.Skeleton) do line:Remove() end
        ESP_Data[p] = nil
    end
end

Players.PlayerRemoving:Connect(cleanESP)

RunService.RenderStepped:Connect(function()
    if not State.Unlocked then return end
    
    local mouseLoc = UserInputService:GetMouseLocation()
    
    -- FOV
    FOVCircle.Visible = State.ShowFOV
    if State.ShowFOV then
        FOVCircle.Position = mouseLoc; FOVCircle.Radius = State.AimbotFOV
        FOVCircle.Color = State.RainbowFOV and Color3fromHSV(tick() % 5 / 5, 1, 1) or CONFIG.Accent
    end
    
    local closest, minDist = nil, State.AimbotFOV
    for _, p in pairs(Players:GetPlayers()) do
        local esp = getESP(p)
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local targetPart = char:FindFirstChild(State.AimbotTarget) or root
            
            if root and targetPart then
                local pos, vis = Camera:WorldToViewportPoint(targetPart.Position)
                
                -- Aimbot Target
                if vis then
                    local dist = (Vector2new(pos.X, pos.Y) - mouseLoc).Magnitude
                    if dist < minDist then
                        if not State.AimbotTeam or p.Team ~= LocalPlayer.Team then
                            if not State.AimbotWall or #Camera:GetPartsObscuringTarget({targetPart.Position}, {LocalPlayer.Character, char}) == 0 then
                                minDist = dist; closest = p
                            end
                        end
                    end
                end
                
                -- ESP Logic
                local color = State.ESPRainbow and Color3fromHSV(tick() % 5 / 5, 1, 1) or CONFIG.Accent
                local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                
                esp.Box.Visible = onScreen and State.ESPBox
                esp.Name.Visible = onScreen and State.ESPName
                esp.Tracer.Visible = onScreen and State.ESPTracer
                
                if onScreen then
                    local size = 1000 / screenPos.Z
                    if State.ESPBox then
                        esp.Box.Size = Vector2new(size, size * 1.5); esp.Box.Position = Vector2new(screenPos.X - size/2, screenPos.Y - (size * 1.5)/2); esp.Box.Color = color
                    end
                    if State.ESPName then
                        esp.Name.Text = p.Name; esp.Name.Size = 14; esp.Name.Center = true; esp.Name.Outline = true; esp.Name.Position = Vector2new(screenPos.X, screenPos.Y - (size * 1.5)/2 - 15); esp.Name.Color = CONFIG.Text
                    end
                    if State.ESPTracer then
                        esp.Tracer.From = Vector2new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); esp.Tracer.To = Vector2new(screenPos.X, screenPos.Y + (size * 1.5)/2); esp.Tracer.Color = color
                    end
                    
                    -- Skeleton ESP (R6 Support)
                    local skel = esp.Skeleton
                    local showSkel = State.ESPSkeleton
                    for _, line in pairs(skel) do line.Visible = showSkel and onScreen; line.Color = color end
                    
                    if showSkel then
                        local head = char:FindFirstChild("Head")
                        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                        local lArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
                        local rArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
                        local lLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftUpperLeg")
                        local rLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightUpperLeg")
                        
                        local function getV2(p) return Camera:WorldToViewportPoint(p.Position) end
                        if head and torso then skel.HeadTorso.From = Vector2new(getV2(head).X, getV2(head).Y); skel.HeadTorso.To = Vector2new(getV2(torso).X, getV2(torso).Y) end
                        if torso and lArm then skel.TorsoLArm.From = Vector2new(getV2(torso).X, getV2(torso).Y); skel.TorsoLArm.To = Vector2new(getV2(lArm).X, getV2(lArm).Y) end
                        if torso and rArm then skel.TorsoRArm.From = Vector2new(getV2(torso).X, getV2(torso).Y); skel.TorsoRArm.To = Vector2new(getV2(rArm).X, getV2(rArm).Y) end
                        if torso and lLeg then skel.TorsoLLeg.From = Vector2new(getV2(torso).X, getV2(torso).Y); skel.TorsoLLeg.To = Vector2new(getV2(lLeg).X, getV2(lLeg).Y) end
                        if torso and rLeg then skel.TorsoRLeg.From = Vector2new(getV2(torso).X, getV2(torso).Y); skel.TorsoRLeg.To = Vector2new(getV2(rLeg).X, getV2(rLeg).Y) end
                    end
                else
                    esp.Box.Visible = false; esp.Name.Visible = false; esp.Tracer.Visible = false
                    for _, line in pairs(esp.Skeleton) do line.Visible = false end
                end
                
                -- Hitbox
                if State.Hitbox > 0 then root.Size = Vector3new(2 + State.Hitbox, 2 + State.Hitbox, 2 + State.Hitbox); root.Transparency = 0.8 end
            end
        else
            esp.Box.Visible = false; esp.Name.Visible = false; esp.Tracer.Visible = false
            for _, line in pairs(esp.Skeleton) do line.Visible = false end
        end
    end
    
    -- Hard Lock Aimbot
    if State.Aimbot and closest and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local targetChar = closest.Character
        local targetPart = targetChar:FindFirstChild(State.AimbotTarget) or targetChar:FindFirstChild("HumanoidRootPart")
        if targetPart then
            local pos = Camera:WorldToViewportPoint(targetPart.Position)
            -- Hard Lock (Smoothness 1 = Instantly snaps)
            mousemoverel((pos.X - mouseLoc.X) / State.AimbotSmooth, (pos.Y - mouseLoc.Y) / State.AimbotSmooth)
        end
    end
    
    -- Triggerbot
    if State.Triggerbot then
        local t = LocalPlayer:GetMouse().Target
        if t and t.Parent and t.Parent:FindFirstChild("Humanoid") then
            local p = Players:GetPlayerFromCharacter(t.Parent)
            if p and p ~= LocalPlayer and (not State.AimbotTeam or p.Team ~= LocalPlayer.Team) then mouse1click() end
        end
    end
    
    -- Movement Engine
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        hum.WalkSpeed = State.Speed
        if State.Fly and root then
            local flyVel = Vector3new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVel = flyVel + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVel = flyVel - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVel = flyVel - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVel = flyVel + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyVel = flyVel + Vector3new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyVel = flyVel - Vector3new(0, 1, 0) end
            root.Velocity = flyVel * State.FlySpeed
            hum.PlatformStand = true
        else
            if hum.PlatformStand then hum.PlatformStand = false end
        end
        if State.Bhop and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if State.Spin and root then root.CFrame = root.CFrame * CFAngles(0, math.rad(25), 0) end
    end
end)

